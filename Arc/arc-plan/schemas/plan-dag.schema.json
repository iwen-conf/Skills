{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arc Write-Set Isolated Plan DAG",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "frozen_contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "write_scope", "verify_cmd"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "runner": { "type": "string" },
          "agent_profile": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "read_scope": { "type": "array", "items": { "type": "string" } },
          "write_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "verify_cmd": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
