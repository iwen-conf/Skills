{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arc Branching Storyline Verification Contract",
  "type": "object",
  "required": ["story_id", "focal_entity", "world_flags", "checkpoints", "routes", "required_endings"],
  "properties": {
    "story_id": { "type": "string", "minLength": 1 },
    "focal_entity": { "type": "string", "minLength": 1 },
    "frozen_readonly": { "type": "array", "items": { "type": "string" } },
    "blind_mask": { "type": "array", "items": { "type": "string" } },
    "world_flags": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["save_id", "parent"],
        "properties": {
          "save_id": { "type": "string", "minLength": 1 },
          "parent": { "type": "string", "minLength": 1 },
          "engine": { "type": "string", "enum": ["dir", "sqlite", "postgres"] },
          "seed_cmd": { "type": "string" },
          "setup_steps": { "type": "array" },
          "assert_flags": { "type": "object" }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route_id", "load_save", "sequence", "unlocks_ending"],
        "properties": {
          "route_id": { "type": "string", "minLength": 1 },
          "load_save": { "type": "string", "minLength": 1 },
          "runner_type": { "type": "string" },
          "agent_hint": { "type": "string" },
          "write_scope": { "type": "array", "items": { "type": "string" } },
          "runtime_ns": { "type": "string" },
          "verify_cmd": { "type": "string" },
          "unlocks_ending": { "type": "string", "minLength": 1 },
          "sequence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["step", "choice", "expect_status"],
              "properties": {
                "step": { "type": "integer", "minimum": 1 },
                "choice": { "type": "string", "minLength": 1 },
                "expect_status": { "type": "string", "minLength": 1 },
                "cmd": { "type": "string" },
                "probe_cmd": { "type": "string" },
                "anti_softlock": { "type": "string" },
                "butterfly_probes": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "required_endings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
