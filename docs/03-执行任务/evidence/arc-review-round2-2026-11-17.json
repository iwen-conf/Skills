  "fixes": [
    {
      "id": "R2-01",
      "change": "Intersect successor policies from all not-disproven outcomes, retaining UNKNOWN candidates and their identity uncertainty",
      "tests": [
        "TestBusinessSuccessorUnknownAlternativeCannotPermitUnprovenContinuation",
        "TestBusinessSuccessorUnknownAlternativeNeverDispatchesForbiddenNextRequest",
        "TestBusinessSuccessorObservedFalseAlternativeDoesNotRestrictContinuation",
        "TestBusinessSuccessorUnknownUnrestrictiveAlternativePreservesProvenPolicy"
      ],
      "observed_boundary": "The red ordinary HTTP sequence sent one forbidden confirmation and passed. The fixed sequence sends none; consistent-hash historical widening is rejected."
    },
    {
      "id": "R2-02",
      "change": "Preserve exact JSON numeric tokens through unique-key validation, model decoding and request/response/Oracle/RAW capture",
      "tests": [
        "TestBusinessExactNumbersDoNotDependOnFloat64Range",
        "TestBusinessExactNumberRuntimePreservesRequestResponseOracleAndLedger",
        "TestBusinessExactNumberModelImportFreezeAndFiniteProof",
        "TestBusinessExactNumberValidationStillRejectsDuplicateKeys"
      ],
      "observed_boundary": "Model-permitted 1e400 traverses a real isolated HTTP action once and revalidates. Existing numeric bounds, duplicate rejection and strict json_i64 token rules remain."
    },
    {
      "id": "R2-03",
      "change": "Revalidate every registered Oracle by action, actor, ID, observation boundary, principal, role, scope and declared field set",
      "tests": [
        "TestRuntimeEveryDeclaredOracleRetainsItsActorAndFixtureScope",
        "TestRuntimeSecondaryOracleWrongScopeBlocksBeforeTarget"
      ],
      "observed_boundary": "Self-consistent archived secondary-reader identity mutations are blocked. Live wrong-reader controls send no target requests; this is not host-controlled evidence authenticity."
    },
    {
      "id": "R2-04",
      "change": "Bind consistency assertions to the final action index rather than Oracle array order",
      "tests": [
        "TestRuntimeConsistencyUsesFinalActionIndexRegardlessOfOracleOrder"
      ],
      "observed_boundary": "Real two-action same-actor/same-Oracle observations retain both FAIL and PASS verdicts when reordered; ambiguous legacy evidence is blocked."
    },
    {
      "id": "R2-05",
      "change": "Require observed Ensures and all declared typed Effects before skipping preparation or satisfying its dependencies",
      "tests": [
        "TestBusinessPreparationKeepsMissingEffectsWhenEnsuresAlreadyTrue",
        "TestBusinessPreparationDependencyNeedsAllObservedEffects",
        "TestBusinessCampaignPreparationUsesMissingEffectAndActualGoalReadback"
      ]
    },
    {
      "id": "R2-06",
      "change": "Before planned preparation writes, validate observer and explicit adapter bindings for subjects referenced by preparation Goal or selected plan Effects and used by the initial target batch; reconstruct historical bindings only from preceding actions",
      "tests": [
        "TestBusinessCampaignPreparationCannotApplyAnotherSubjectsEffects",
        "TestRuntimePreparationBindsEntityCreatedByActualSetup"
      ],
      "observed_boundary": "Wrong observer/adapter through campaign and execute now produce zero preparation, target and recovery requests. ADMIN preparing the same STUDENT, static setup creation and auto-preparation creation remain valid. Baseline preflight may defer absent IDs until setup. For checked subjects, actual plan admission permits IDs absent on both sides only when requires_binding=false; a known ID with a missing or different counterpart is blocked."
    },
    {
      "id": "R2-07",
      "change": "Keep projection node summaries in their source environment and round rather than borrowing PASS into another selected context",
      "tests": [
        "workbench/src/projection-isolation.test.tsx"
      ]
    },
    {
      "id": "R2-08",
      "change": "Check declared model ID/hash across metadata, model, projections and nonempty proof contexts while preserving no-round model-only exports",
      "tests": [
        "workbench/src/projection-isolation.test.tsx"
      ],
      "observed_boundary": "Reader consistency validation does not cryptographically verify model contents or RAW authenticity in the browser."
    },
    {
      "id": "R2-09",
      "change": "Select captured before/after entity identities without merging equal display IDs across alias, kind, owner or channel",
      "tests": [
        "workbench/src/projection-isolation.test.tsx"
      ],
      "observed_boundary": "Before-only entities remain inspectable after identity failure. A missing after record is not asserted deletion. Unresolved outcome candidates are also displayed without changing the backend verdict."
    },
    {
      "id": "R2-10",
      "change": "Bind selected branch.rule to the step registered rule at registration, pre-action freezing and offline reconstruction",
      "tests": [
        "TestRuntimeBusinessSelectedBranchCannotBorrowAnotherRulesExpectation",
        "TestRuntimeBusinessNamedBranchMustBelongToTheRegisteredRule",
        "TestRuntimeBusinessCorrectRuleExecutesButCannotRequalifyAnotherRule"
      ],
      "observed_boundary": "Both same-role and different-role wrong-rule red runs issued a request and passed; fixed runs issue zero. A correctly bound R-OTHER run and its own qualification still pass."
    }
  ],
