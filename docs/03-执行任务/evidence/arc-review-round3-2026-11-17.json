      "reproduction_fixture_source": "package main\n\nimport (\n  \"testing\"\n)\n\n// Read-only frontend regression source: inject through go -overlay, never into\n// repository Go sources. The target is the existing explicit tool HTTP fixture.\nfunc TestRound3FrontendOracleFailureExport(t *testing.T) {\n  target, server := newKindsServer(t)\n  f := prepareExecutionFixture(t, successorSequenceGraph(t, nil), server.URL)\n  const runner = \"round3-prefreeze-oracle-failure\"\n  manifest := kindsManifest(t, runner, \"test.sequence.enroll-confirm\",\n    kindsStep(\"enroll\", \"submit-flow\", \"/enroll\", kindsOracle(\"fixture-independent-store\", \"/oracle\")),\n    kindsStep(\"confirm\", \"confirm-flow\", \"/confirm\", kindsOracle(\"confirm-store\", \"/missing-oracle\")))\n  f.registerAndRound(t, manifest)\n  result := executeKinds(t, f, runner, \"test.sequence.enroll-confirm\")\n  if result.Verdict != \"BLOCKED\" || result.Steps != 2 || target.confirmCalls != 0 {\n    t.Fatalf(\"before-oracle failure did not stop the second request: %+v confirms=%d\", result, target.confirmCalls)\n  }\n  exported, err := f.d.snapshotRun(\"course-v2\", result.Run)\n  if err != nil || exported.BranchID != \"enroll-only-again\" || exported.EvidenceStatus != \"PASS\" {\n    t.Fatalf(\"not a verified mixed run: %+v %v\", exported, err)\n  }\n  found := false\n  for _, fact := range exported.Facts {\n    if fact.Seq == 2 {\n      found = fact.SourceKind == \"sequence\" && fact.Node == \"confirm\" && fact.Verdict == \"BLOCKED\" && len(fact.BusinessExpectations) == 0\n    }\n  }\n  if !found { t.Fatalf(\"missing native pre-freeze failure fact: %+v\", exported.Facts) }\n  path, err := f.d.writeSnapshot(SnapshotRequest{Graph:\"course-v2\", Environment:\"independent\", Round:f.round, Config:f.config,\n    Assets:\"/workspace/scratch/5b127f988034/arc-rebuild/tools/arc-verify/workbench/dist\",\n    Out:\"/workspace/scratch/5b127f988034/arc-round3-oracle-failure-final\", Runs:[]string{result.Run},\n    Argv:[]string{\"frontend-prefreeze-regression\",\"tool-fixture-not-product-e2e\"}})\n  if err != nil { t.Fatal(err) }\n  t.Logf(\"run=%s frozen-branch=%s second-action-requests=%d snapshot=%s\", result.Run, exported.BranchID, target.confirmCalls, path)\n}\n",
      "reproduction_note": "The exact overlay fixture is retained here for reproduction; adapt absolute repository and export paths when running elsewhere. It depends on the repository test helpers and is not a product Runner."
