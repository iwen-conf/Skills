  "fixes": [
    {
      "id": "R3-01",
      "change": "Evaluate each batch operation rule invariant with its own actor, action index, Oracle ID and boundary",
      "tests": [
        "TestRuntimeRound3ParallelInvariantsCoverEveryParticipant",
        "TestRuntimeRound3HistoricalInvariantCannotBorrowHealthyFinalParticipant",
        "TestRuntimeRound3RepeatedActorInvariantsKeepActionIndex"
      ],
      "observed_boundary": "Four valid red counterexamples (typed/legacy, both participant orderings) returned business PASS when the nonfinal actor had enrolled=3/capacity=2. Fixed live and offline results are FAIL with valid evidence. Same-actor repeated actions retain independent action-index readings. Self-consistent historical hashes cannot qualify the violation as PASS."
    },
    {
      "id": "R3-02",
      "change": "Exclude branches inapplicable to the known prestate before enforcing their flow identity requirements",
      "tests": [
        "TestRound3BusinessUnrelatedPrestateDoesNotRequireItsFlow"
      ],
      "observed_boundary": "Both branch orders previously blocked the complete pending-state partition because a ready-only branch required flow. Known current-state candidates still require flow; the finite proof remains limited to its declared scope. This was a false BLOCKED, not a false PASS."
    },
    {
      "id": "R3-03",
      "change": "Derive campaign failure boundaries from child evidence; reject later dispatches and contradictory stop labels; resume never crosses FirstDivergence",
      "tests": [
        "TestBusinessCampaignCannotResumePastVerifiedFailureByChangingStopStatus",
        "TestBusinessCampaignResumeContinuesHealthyCancellationStop"
      ],
      "observed_boundary": "Actual FAIL/BLOCKED child runs remained intact while the stop status alone was changed to BUDGET with consistent event hashes. Previously resume issued an extra target request (1->2 or 0->1); fixed counters remain 1 and 0. Original failure evidence and explicit abort remain valid, and a healthy cancellation budget stop still resumes."
    },
    {
      "id": "R3-04",
      "change": "Keep unbound typed action and actor decisions diagnostic within mixed runs; do not borrow another step or actor branch; preserve selected diagnostic scope during rendering",
      "tests": [
        "workbench/src/selection-diagnostics.test.tsx",
        "workbench/src/go-export.integration.test.tsx"
      ],
      "observed_boundary": "An actual Go sequence export has a passing frozen first step followed by an Oracle-404 second step without business_expectations and no second target request. The run-level branch still identifies step 1; step 2 must render as unresolved. Explicit BLOCKED decisions, missing/empty arrays and per-actor partial freezes are separately tested. Old exports without unified facts retain their recorded legacy association."
    },
    {
      "id": "R3-05",
      "change": "Validate nested evidence envelope and RAW run/phase/step identity, declared graph/task identity and occurrence uniqueness before rendering",
      "tests": [
        "workbench/src/snapshot-evidence.test.tsx"
      ],
      "observed_boundary": "Another run complete RAW entry and internal scope mutations are rejected. Setup envelope step 0 versus RAW step -1, omitted legacy action phase and error-only evidence entries remain readable. This is consistency validation, not frontend RAW hash/authenticity verification."
    }
  ],
