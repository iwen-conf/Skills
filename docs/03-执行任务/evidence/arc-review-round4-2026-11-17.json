  "fixes": [
    {
      "id": "R4-01",
      "problem": "Relative executable was hashed in the CLI cwd but executed in the child directory.",
      "fix": "Shared command directory/executable resolvers; absolute PATH selection; current historical qualification reuses the same fingerprint.",
      "evidence": "Changed actual script previously issued one target request and PASS. Fixed result blocks before dispatch. Downstream snapshot now preserves the original trace and RAW but reports evidence BLOCKED and zero passing branch coverage, without replay."
    },
    {
      "id": "R4-02",
      "problem": "A source-relative script argument absent in the CLI cwd was skipped and never frozen.",
      "fix": "Require the frozen SourceRoot at round admission/revalidation, resolve static file arguments there, and require declared input_files.",
      "evidence": "Ignored undeclared script previously ran and PASSed. Fixed round refuses before SUT IO; declared inputs remain valid across absolute, relative and default directories."
    },
    {
      "id": "R4-03",
      "problem": "Artifact source copies could act as owning red/green tests and be auto-selected as Python regressions.",
      "fix": "Check direct execution inputs, executable paths and cwd changes including symlinks/PATH; recheck old red commands; exclude artifact Python source copies from discovery.",
      "evidence": "Original artifact entry, replay and automatic discovery cases failed before repair; passive sources, baseline blobs and report outputs remain supported."
    },
    {
      "id": "R4-04",
      "problem": "Red log archival failed with EXDEV across filesystems.",
      "fix": "On EXDEV only, copy into the destination directory, fsync, atomically replace, and record the archived byte hash.",
      "evidence": "Actual different-device temporary/archive paths reproduce the failure; regression checks exact retained bytes and no source mutation."
    },
    {
      "id": "R4-05",
      "problem": "Go setup failures could count as assertion red, including legacy records; zero-test green could qualify a repair.",
      "fix": "Reclassify original logs at both first-red admission and replay; reject known zero-test/build-only green output and invalid evidence.",
      "evidence": "Original red-001 is retained but no longer qualifying. Setup, legacy classification and zero-test controls exercise the shared gate."
    }
  ],
