{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --host codex",
            "timeout": 15,
            "statusMessage": "Arc policy session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --host codex",
            "timeout": 30,
            "statusMessage": "Arc policy guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --host codex",
            "timeout": 30,
            "statusMessage": "Arc policy record"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --host codex",
            "timeout": 15,
            "statusMessage": "Arc policy verify"
          }
        ]
      }
    ]
  }
}
