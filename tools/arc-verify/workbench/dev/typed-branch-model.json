{
  "id": "course-v2",
  "scope": "Reference course fixture for tool acceptance; not a product contract",
  "nodes": [
    {
      "id": "course",
      "kind": "system",
      "name": "课程系统"
    },
    {
      "id": "enrollment",
      "kind": "domain",
      "name": "报名业务"
    },
    {
      "id": "enrollment.submit",
      "kind": "capability",
      "name": "提交报名"
    },
    {
      "id": "course.boundary",
      "kind": "boundary",
      "name": "课程边界"
    },
    {
      "id": "STUDENT",
      "kind": "role",
      "name": "学员"
    },
    {
      "id": "enroll",
      "kind": "action",
      "name": "创建报名记录"
    },
    {
      "id": "login",
      "kind": "condition",
      "name": "已认证"
    },
    {
      "id": "pending",
      "kind": "state",
      "name": "未报名"
    },
    {
      "id": "ready",
      "kind": "state",
      "name": "报名成功"
    },
    {
      "id": "enrollment.records",
      "kind": "data",
      "name": "报名记录"
    }
  ],
  "edges": [
    {
      "id": "contains-domain",
      "from": "course",
      "to": "enrollment",
      "kind": "contains"
    },
    {
      "id": "contains-capability",
      "from": "enrollment",
      "to": "enrollment.submit",
      "kind": "contains"
    },
    {
      "id": "implements-enroll",
      "from": "enrollment.submit",
      "to": "enroll",
      "kind": "implements"
    },
    {
      "id": "owns-enroll",
      "from": "course.boundary",
      "to": "enrollment.submit",
      "kind": "owns"
    },
    {
      "id": "owns-data",
      "from": "course.boundary",
      "to": "enrollment.records",
      "kind": "owns"
    },
    {
      "id": "serves-student",
      "from": "STUDENT",
      "to": "enrollment",
      "kind": "serves"
    },
    {
      "id": "requires-login",
      "from": "login",
      "to": "enroll",
      "kind": "requires"
    },
    {
      "id": "creates-ready",
      "from": "enroll",
      "to": "ready",
      "kind": "transitions"
    },
    {
      "id": "submit-flow",
      "from": "pending",
      "to": "ready",
      "kind": "transitions_to"
    },
    {
      "id": "test-capacity",
      "from": "test.idempotency",
      "to": "invariant.capacity",
      "kind": "verifies"
    }
  ],
  "rules": [
    {
      "id": "R1",
      "action": "enroll",
      "actor": "STUDENT",
      "entry": "/enroll",
      "oracle": "fixture-independent-store",
      "conditions": [
        "login"
      ],
      "expected": "ready",
      "rejected": "UNCHANGED",
      "source": "document",
      "description": "Authenticated reference fixture enrollment"
    }
  ],
  "risks": [],
  "schema_version": 2,
  "system": "course",
  "contracts": [
    {
      "subject": "enrollment.submit",
      "description": "Reference enrollment operation",
      "inputs": [
        "student",
        "course"
      ],
      "outputs": [
        "enrollment_id"
      ],
      "source": "document",
      "source_ref": "reference-fixture"
    }
  ],
  "transitions": [
    {
      "edge": "submit-flow",
      "action": "enroll",
      "rule": "R1",
      "preconditions": {
        "login": true
      },
      "outcome": "success"
    }
  ],
  "flows": [
    {
      "id": "flow.enrollment",
      "capability": "enrollment.submit",
      "initial": "pending"
    }
  ],
  "invariants": [
    {
      "id": "invariant.capacity",
      "name": "报名不得超过容量",
      "scope": [
        "enrollment.submit"
      ],
      "oracle": "fixture-independent-store",
      "observation_boundary": "after committed enrollment and fixture restoration",
      "checks": [
        {
          "left": "enrolled",
          "operator": "lte",
          "right": "capacity"
        }
      ],
      "source": "document",
      "source_ref": "reference-fixture"
    }
  ],
  "tests": [
    {
      "id": "test.idempotency",
      "name": "重复报名保持不变量",
      "rule": "R1",
      "kind": "IDEMPOTENCY",
      "preconditions": {
        "login": true
      },
      "expected": "ready",
      "source": "document",
      "source_ref": "reference-fixture"
    }
  ],
  "business_contract": {
    "version": 1,
    "subjects": [
      {
        "id": "primary",
        "kind": "actor",
        "requires_binding": true,
        "attributes": [
          {
            "name": "active",
            "type": "boolean"
          },
          {
            "name": "level",
            "type": "integer"
          },
          {
            "name": "tags",
            "type": "string_set"
          },
          {
            "name": "id",
            "type": "string"
          }
        ]
      },
      {
        "id": "other",
        "kind": "actor",
        "requires_binding": true,
        "attributes": [
          {
            "name": "active",
            "type": "boolean"
          },
          {
            "name": "id",
            "type": "string"
          }
        ]
      },
      {
        "id": "order",
        "kind": "entity",
        "attributes": [
          {
            "name": "owner",
            "type": "string"
          },
          {
            "name": "amount",
            "type": "number"
          },
          {
            "name": "stored",
            "type": "boolean"
          },
          {
            "name": "events",
            "type": "integer"
          },
          {
            "name": "balance",
            "type": "integer"
          }
        ]
      }
    ],
    "branches": [
      {
        "id": "accept",
        "action": "enroll",
        "rule": "R1",
        "flow": "flow.enrollment",
        "from_states": [
          "pending"
        ],
        "when": {
          "op": "eq",
          "left": {
            "ref": {
              "subject": "primary",
              "attribute": "active"
            }
          },
          "right": {
            "literal": {
              "type": "boolean",
              "value": true
            }
          }
        },
        "expected": {
          "mode": "deterministic",
          "outcomes": [
            {
              "id": "created",
              "state": "ready",
              "denied": false,
              "predicate": {
                "op": "true"
              }
            }
          ]
        },
        "source": "document",
        "source_ref": "test-spec:active",
        "confirmed": true
      },
      {
        "id": "reject",
        "action": "enroll",
        "rule": "R1",
        "flow": "flow.enrollment",
        "from_states": [
          "pending"
        ],
        "when": {
          "op": "not",
          "args": [
            {
              "op": "eq",
              "left": {
                "ref": {
                  "subject": "primary",
                  "attribute": "active"
                }
              },
              "right": {
                "literal": {
                  "type": "boolean",
                  "value": true
                }
              }
            }
          ]
        },
        "expected": {
          "mode": "deterministic",
          "outcomes": [
            {
              "id": "unchanged",
              "state": "UNCHANGED",
              "denied": true,
              "predicate": {
                "op": "true"
              }
            }
          ]
        },
        "source": "document",
        "source_ref": "test-spec:inactive",
        "confirmed": true
      }
    ],
    "coverage": {
      "scope": "all declared boolean activation values in pending enrollment; no path or SUT claim",
      "domains": [
        {
          "subject": "primary",
          "attribute": "active",
          "values": [
            false,
            true
          ]
        }
      ],
      "max_cases": 100,
      "scopes": [
        {
          "action": "enroll",
          "flow": "flow.enrollment",
          "states": [
            "pending"
          ]
        }
      ]
    }
  }
}